# ===========================================
# yunissaem 환경변수 예시 파일
# 이 파일을 복사해서 .env로 저장 후 값을 수정하세요
# ===========================================

# PostgreSQL 데이터베이스 설정
POSTGRES_DB=yunissaem
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Django Secret Key
DJANGO_SECRET_KEY=your_secret_key_here

# Debug Mode (배포에서는 False)
DJANGO_DEBUG=True

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Expo Go 연결용 PC IP (본인 Wi-Fi IP로 변경)
# Windows: ipconfig 명령어로 Wi-Fi 어댑터의 IPv4 주소 확인
PC_IP=localhost
